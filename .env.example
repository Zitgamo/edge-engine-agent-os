# Data source
DATA_SOURCE=yfinance  # yfinance (free), mock

# Model
MODEL_PATH=models/xgboost_model.json

# Dashboard
DASHBOARD_PORT=8501

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Telegram notification (optional — leave empty to skip)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase (cloud DB for dashboard — free tier)
# Create project at https://supabase.com, then copy keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key  # needed for auto table creation

# Trading params
STOP_LOSS=-0.03
TAKE_PROFIT=0.08
