# Data source
DATA_SOURCE=yfinance  # yfinance, kbs (public EOD), mock
DATA_LOOKBACK_DAYS=365
KBS_BASE_URL=https://kbbuddywts.kbsec.com.vn/iis-server/investment
KBS_TIMEOUT_SECONDS=20
PAPER_RAW_DATA_DIR=data/paper_raw
PAPER_LOOKBACK_DAYS=1825
PAPER_REFRESH_DAYS=120
PAPER_STRATEGY_NAME=vn30_rs_atr2_tp10
PAPER_MIN_BREADTH_20D=0.60
PAPER_MIN_UNIVERSE_COUNT=30
PAPER_TOP_N=3
PAPER_ATR_MULTIPLE=2.0
PAPER_TAKE_PROFIT=0.10
TICKER_EXIT_BASELINE_ATR_MULTIPLE=2.0
TICKER_EXIT_BASELINE_TAKE_PROFIT=0.10
TICKER_EXIT_UNIVERSE=vn30
TICKER_EXIT_WALK_FORWARD_FOLDS=3
TICKER_EXIT_MINIMUM_CONSENSUS_FOLDS=0  # 0 = automatic two-thirds consensus
TICKER_EXIT_RESEARCH_LOOKBACK_DAYS=1825
TICKER_EXIT_RESEARCH_REFRESH_DAYS=120
# Research-generated per-ticker exits. Keep disabled until the locked holdout
# confirms an improvement over the baseline.
ENABLE_TICKER_EXIT_PROFILES=false
TICKER_EXIT_PROFILE_PATH=data/research_kbs_5y/research_results/ticker_exit_profiles.json
PAPER_TICKER_EXIT_STRATEGY_NAME=vn30_rs_ticker_exit_v1
PAPER_MIN_TRADES=100
PAPER_TARGET_TRADES=100
PAPER_MIN_BASKETS=30
PAPER_TARGET_BASKETS=50

# Model
MODEL_PATH=models/xgboost_model_h20.json

# Dashboard
DASHBOARD_PORT=8501

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Telegram notification (optional — leave empty to skip)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase (cloud DB for dashboard — free tier)
# Create project at https://supabase.com, then copy keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key  # needed for cloud writes; run supabase_setup.sql once

# Rolling regime-aware training and publication gates
MODEL_TRAINING_DAYS=180
MODEL_QUALITY_TEST_DAYS=40
MIN_MODEL_QUALITY_DATES=30
MIN_MODEL_ROC_AUC=0.52
MIN_MODEL_TOP3_EXCESS_RETURN=0.0
MIN_MODEL_TOP3_SPREAD=0.0

# Trading params
STOP_LOSS=-0.005
TAKE_PROFIT=0.10
ROUND_TRIP_COST=0.003  # Conservative all-in round-trip cost; override for your broker

# Execution-aligned T+20 target and paper-tested entry filters
EXECUTION_TARGET_ENABLED=true
ENSEMBLE_HORIZON_WEIGHTS=1:1.0,5:1.0,10:1.0,20:1.0
ENSEMBLE_BLEND_MODE=max
PRIMARY_RANKING_STRATEGY=outperform
ENABLE_ENTRY_FILTERS=true
ENABLE_RESEARCH_STRATEGIES=false  # Trend/breakout/fundamental modules stay out of production by default
MIN_MARKET_BREADTH_20D=0.50
MIN_ENTRY_ATR_PERCENTILE=0.20
MIN_ENTRY_TREND_PERCENTILE=0.00
MIN_ENTRY_PICKS=3
MIN_ENTRY_SCORE=0.10
MIN_ENTRY_SCORE_MARGIN=0.02
